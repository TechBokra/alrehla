{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2020",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@alrehla/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@alrehla/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@alrehla/api": [
        "../../packages/api/src/index.ts"
      ],
      "@alrehla/api/*": [
        "../../packages/api/src/*"
      ],
      "@alrehla/auth": [
        "../../packages/auth/src/index.ts"
      ],
      "@alrehla/auth/*": [
        "../../packages/auth/src/*"
      ],
      "@alrehla/types": [
        "../../packages/types/src/index.ts"
      ],
      "@alrehla/types/*": [
        "../../packages/types/src/*"
      ],
      "@alrehla/config": [
        "../../packages/config/src/index.ts"
      ],
      "@alrehla/config/*": [
        "../../packages/config/src/*"
      ],
      "@alrehla/utils": [
        "../../packages/utils/src/index.ts"
      ],
      "@alrehla/utils/*": [
        "../../packages/utils/src/*"
      ]
    },
    "strictNullChecks": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
