{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2020",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@alrehla/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@alrehla/ui/image": [
        "../../packages/ui/src/Image.tsx"
      ],
      "@alrehla/ui/modal": [
        "../../packages/ui/src/Modal.tsx"
      ],
      "@alrehla/ui/skeletons": [
        "../../packages/ui/src/Skeletons.tsx"
      ],
      "@alrehla/ui/date-picker": [
        "../../packages/ui/src/components/ui/date-picker.tsx"
      ],
      "@alrehla/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@alrehla/api": [
        "../../packages/api/src/index.ts"
      ],
      "@alrehla/api/*": [
        "../../packages/api/src/*"
      ],
      "@alrehla/auth": [
        "../../packages/auth/src/index.ts"
      ],
      "@alrehla/auth/*": [
        "../../packages/auth/src/*"
      ],
      "@alrehla/types": [
        "../../packages/types/src/index.ts"
      ],
      "@alrehla/types/*": [
        "../../packages/types/src/*"
      ],
      "@alrehla/config": [
        "../../packages/config/src/index.ts"
      ],
      "@alrehla/config/*": [
        "../../packages/config/src/*"
      ],
      "@alrehla/utils": [
        "../../packages/utils/src/index.ts"
      ],
      "@alrehla/utils/*": [
        "../../packages/utils/src/*"
      ],
      "@alrehla/admin-core": [
        "../../packages/admin-core/src/index.ts"
      ],
      "@alrehla/admin-core/*": [
        "../../packages/admin-core/src/*"
      ],
      "@alrehla/forms": [
        "../../packages/forms/src/index.ts"
      ],
      "@alrehla/forms/*": [
        "../../packages/forms/src/*"
      ],
      "@alrehla/mutations": [
        "../../packages/mutations/src/index.ts"
      ],
      "@alrehla/mutations/*": [
        "../../packages/mutations/src/*"
      ],
      "@eng-mohamedelsayed/admin-core": [
        "../../packages/admin/core/src/index.ts"
      ],
      "@eng-mohamedelsayed/admin-core/*": [
        "../../packages/admin/core/src/*"
      ],
      "@eng-mohamedelsayed/admin-forms": [
        "../../packages/admin/forms/src/index.ts"
      ],
      "@eng-mohamedelsayed/admin-forms/resource": [
        "../../packages/admin/forms/src/components/resource/index.ts"
      ],
      "@eng-mohamedelsayed/admin-forms/resource/*": [
        "../../packages/admin/forms/src/components/resource/*"
      ],
      "@eng-mohamedelsayed/admin-forms/*": [
        "../../packages/admin/forms/src/*"
      ],
      "@eng-mohamedelsayed/admin-shell": [
        "../../packages/admin/shell/src/index.ts"
      ],
      "@eng-mohamedelsayed/admin-shell/*": [
        "../../packages/admin/shell/src/*"
      ],
      "@eng-mohamedelsayed/admin-ui": [
        "../../packages/admin/ui/src/index.ts"
      ],
      "@eng-mohamedelsayed/admin-ui/*": [
        "../../packages/admin/ui/src/*"
      ],
      "@eng-mohamedelsayed/mutations": [
        "../../packages/mutations/src/index.ts"
      ],
      "@eng-mohamedelsayed/mutations/*": [
        "../../packages/mutations/src/*"
      ]
    },
    "strictNullChecks": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
