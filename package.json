{
  "name": "alrehla-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "turbo run dev --parallel",
    "dev:marketplace": "pnpm --filter @alrehla/marketplace dev",
    "dev:admin": "pnpm --filter @alrehla/admin-panel dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "start": "turbo run start",
    "build:marketplace": "pnpm --filter @alrehla/marketplace build",
    "build:admin": "pnpm --filter @alrehla/admin-panel build"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.3",
    "vite": "^6.3.5",
    "turbo": "^2.5.4",
    "prettier": "^3.3.3",
    "eslint": "^9.0.0"
  }
}
