{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "baseUrl": ".",
    "paths": {
      "@alrehla/ui": [
        "packages/ui/src/index.ts"
      ],
      "@alrehla/ui/image": [
        "packages/ui/src/Image.tsx"
      ],
      "@alrehla/ui/modal": [
        "packages/ui/src/Modal.tsx"
      ],
      "@alrehla/ui/skeletons": [
        "packages/ui/src/Skeletons.tsx"
      ],
      "@alrehla/ui/*": [
        "packages/ui/src/*"
      ],
      "@alrehla/api": [
        "packages/api/src/index.ts"
      ],
      "@alrehla/api/*": [
        "packages/api/src/*"
      ],
      "@alrehla/api-client": [
        "packages/api-client/src/index.ts"
      ],
      "@alrehla/api-client/*": [
        "packages/api-client/src/*"
      ],
      "@alrehla/auth": [
        "packages/auth/src/index.ts"
      ],
      "@alrehla/auth/*": [
        "packages/auth/src/*"
      ],
      "@alrehla/types": [
        "packages/types/src/index.ts"
      ],
      "@alrehla/types/*": [
        "packages/types/src/*"
      ],
      "@alrehla/config": [
        "packages/config/src/index.ts"
      ],
      "@alrehla/config/*": [
        "packages/config/src/*"
      ],
      "@alrehla/utils": [
        "packages/utils/src/index.ts"
      ],
      "@alrehla/utils/*": [
        "packages/utils/src/*"
      ],
      "@alrehla/forms": [
        "packages/forms/src/index.ts"
      ],
      "@alrehla/forms/*": [
        "packages/forms/src/*"
      ],
      "@alrehla/mutations": [
        "packages/mutations/src/index.ts"
      ],
      "@alrehla/mutations/*": [
        "packages/mutations/src/*"
      ],
      "@alrehla/admin-core": [
        "packages/admin-core/src/index.ts"
      ],
      "@alrehla/admin-core/*": [
        "packages/admin-core/src/*"
      ],
      "@alrehla/supabase/public": [
        "packages/supabase/src/public.ts"
      ],
      "@alrehla/supabase/server": [
        "packages/supabase/src/server.ts"
      ],
      "@alrehla/supabase/admin": [
        "packages/supabase/src/admin.ts"
      ],
      "@alrehla/supabase/types": [
        "packages/supabase/src/types.ts"
      ],
      "@eng-mohamedelsayed/admin-core": [
        "packages/admin/core/src/index.ts"
      ],
      "@eng-mohamedelsayed/admin-core/*": [
        "packages/admin/core/src/*"
      ],
      "@eng-mohamedelsayed/admin-forms": [
        "packages/admin/forms/src/index.ts"
      ],
      "@eng-mohamedelsayed/admin-forms/resource": [
        "packages/admin/forms/src/components/resource/index.ts"
      ],
      "@eng-mohamedelsayed/admin-forms/resource/*": [
        "packages/admin/forms/src/components/resource/*"
      ],
      "@eng-mohamedelsayed/admin-forms/*": [
        "packages/admin/forms/src/*"
      ],
      "@eng-mohamedelsayed/admin-shell": [
        "packages/admin/shell/src/index.ts"
      ],
      "@eng-mohamedelsayed/admin-shell/*": [
        "packages/admin/shell/src/*"
      ],
      "@eng-mohamedelsayed/admin-ui": [
        "packages/admin/ui/src/index.ts"
      ],
      "@eng-mohamedelsayed/admin-ui/*": [
        "packages/admin/ui/src/*"
      ],
      "@eng-mohamedelsayed/mutations": [
        "packages/mutations/src/index.ts"
      ],
      "@eng-mohamedelsayed/mutations/*": [
        "packages/mutations/src/*"
      ]
    }
  }
}
