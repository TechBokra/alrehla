ARCJET_KEY=
ARCJET_ENV=
ARCJET_MODE=
# Pooled Neon URL used by the NestJS application.
DATABASE_URL=
# Direct Neon URL (without `-pooler`) used by Prisma CLI migrations.
DATABASE_URL_UNPOOLED=

# Generate a high-entropy value with `pnpm dlx auth@latest secret`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
PORT=3000

# Comma-separated browser application origins when the frontend is cross-origin.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001
# Production:
# BETTER_AUTH_URL=https://alrehla-api.alrehla.org
# BETTER_AUTH_TRUSTED_ORIGINS=https://alrehla-web.alrehla.org/
